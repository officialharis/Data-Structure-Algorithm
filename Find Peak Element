
class Solution {
    public int findPeakElement(int[] nums) {

        // start pointer
        int low = 0;

        // end pointer
        int high = nums.length - 1;

        // binary search
        while(low < high){

            // correct mid calculation
            int mid = low + (high - low) / 2;

            // if next element is bigger, peak is on right side
            if(nums[mid] < nums[mid + 1]){
                low = mid + 1;
            }
            else{
                // peak is on left side (including mid)
                high = mid;
            }
        }

        // garbage collection not needed
        // System.gc();

        // low == high → peak index
        return low;
    }
}

