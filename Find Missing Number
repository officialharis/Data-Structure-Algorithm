## Easy method 
## Time complexity is = O(NLogN)
class Solution {
    public int missingNumber(int[] arr) {

        Arrays.sort(arr);

        int ct = 0;

        for (int i = 0; i < arr.length; i++) {
            if (arr[i] == ct) {
                ct++;
            }
        }
        return ct;

    }
}

## second approach 
## Time complexity is = O(n)

class Solution {
    public int missingNumber(int[] arr) {

        int n = arr.length;

        return (n*(n+1)/2) - Arrays.stream(arr).sum();

    }
}

## third approach
## Time complexity is O(n) but space complexity is O(1)

class Solution {
    public int missingNumber(int[] arr) {

        // res will store the XOR result
        // Start with 0 because XOR with 0 does not change value
        int res = 0;

        // Loop through the array
        for (int i = 0; i < arr.length; i++) {

            // XOR current index (i) and array value (arr[i]) with res
            // Same numbers cancel each other in XOR
            // Example: 3 ^ 3 = 0
            res = res ^ i ^ arr[i];
        }

        // Finally XOR with arr.length
        // This includes the last number (n) in range [0 to n]
        // The remaining value is the missing number
        return res ^ arr.length;
    }
}
