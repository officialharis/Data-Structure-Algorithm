## Easy method 
## Time complexity is = O(NLogN)
class Solution {
    public int missingNumber(int[] arr) {

        Arrays.sort(arr);

        int ct = 0;

        for (int i = 0; i < arr.length; i++) {
            if (arr[i] == ct) {
                ct++;
            }
        }
        return ct;

    }
}

