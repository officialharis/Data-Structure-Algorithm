import java.util.*;

public class Main {
    public static void main(String[] args) {

        // Sorted input array
        int[] arr = {2, 4, 6, 8, 11};

        // Target sum to find
        int target = 10;

        // Two pointers:
        // i starts from beginning of the array
        // j starts from end of the array
        int i = 0, j = arr.length - 1;

        // Loop until both pointers meet
        while (i < j) {

            // Calculate sum of elements at i and j
            int sum = arr[i] + arr[j];

            // If pair sum matches the target
            if (sum == target) {
                System.out.print(arr[i] + " " + arr[j]);
                break; // Exit loop after finding the pair
            }

            // If sum is smaller than target, move left pointer forward
            else if (sum < target) {
                i++;
            }

            // If sum is greater than target, move right pointer backward
            else {
                j--;
            }
        }
    }
}
