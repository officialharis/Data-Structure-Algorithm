class Solution {
    public boolean isPalindrome(String s) {
        
        // Convert the string to lowercase and remove all non-alphanumeric characters
        // This ensures we only compare letters and numbers, ignoring spaces and symbols
        s = s.toLowerCase().replaceAll("[^A-Za-z0-9]" , "");

        // Initialize two pointers:
        // i starts from the beginning
        // j starts from the end
        int i = 0; 
        int j = s.length() - 1;

        // Loop until the two pointers meet or cross
        while (i <= j) {

            // If characters at current positions are not equal,
            // the string is NOT a palindrome
            if (s.charAt(i) != s.charAt(j)) {
                return false;
            } 
            else {
                // Move both pointers towards the center
                i++;
                j--;
            }
        }

        // If all characters matched, the string is a palindrome
        return true;
    }
}
