class Solution {
    public int lengthOfLastWord(String s) {

        // Variable to store length of last word
        int count = 0;

        // Start from the last index of the string
        int i = s.length() - 1;

        // Step 1: Skip trailing spaces (spaces at the end)
        // Example: "Hello World   "
        // Move pointer left until we find a non-space character
        while (i >= 0 && s.charAt(i) == ' ') {
            i--;  // keep moving left
        }

        // Step 2: Count characters of the last word
        // Now 'i' is at the last character of the last word
        // Keep counting until we hit a space or start of string
        while (i >= 0 && s.charAt(i) != ' ') {
            count++;  // count each character
            i--;      // move left
        }

        // Step 3: Return the length of the last word
        return count;
    }
}
