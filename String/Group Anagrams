import java.util.*;

class Solution {
    public List<List<String>> groupAnagrams(String[] strs) {
        
        // Create a HashMap:
        // Key   -> sorted version of word
        // Value -> list of words that are anagrams
        HashMap<String, List<String>> map = new HashMap<>();

        // Traverse each word in the input array
        for (String word : strs) {

            // Step 1: Convert the word into a character array
            // Example: "eat" -> ['e','a','t']
            char[] arr = word.toCharArray();

            // Step 2: Sort the character array
            // Example: ['e','a','t'] -> ['a','e','t']
            Arrays.sort(arr);

            // Step 3: Convert sorted array back to String
            // This becomes the key
            // Example: "aet"
            String key = new String(arr);

            // Step 4: If this key is not already in the map,
            // create a new list for this group
            if (!map.containsKey(key)) {
                map.put(key, new ArrayList<>());
            }

            // Step 5: Add the original word (not sorted)
            // to the corresponding anagram group
            map.get(key).add(word);
        }

        // Step 6: Return all grouped anagrams
        // map.values() gives all lists of grouped words
        return new ArrayList<>(map.values());
    }
}
🧠 Key Idea (in simple words)

Sort each word → get a common key

Same key → same anagram group

Store groups using HashMap

🔍 Example Flow

Input:

["eat","tea","tan","ate","nat","bat"]

Map will look like:

"aet" → ["eat","tea","ate"]
"ant" → ["tan","nat"]
"abt" → ["bat"]
⚡ Final Output
[
 ["eat","tea","ate"],
 ["tan","nat"],
 ["bat"]
]
