//Brute Force Approact

class Solution {
    public int majorityElement(int[] arr) {
        int n = arr.length;

        for (int val : arr) {
            int fq = 0;

            for (int el : arr) {
                if (el == val) {
                    fq++;
                }
            }
            if (fq > n / 2) {
                return val;
            }
        }
        return -1;
    }
}

// Optimal Approach
class Solution {
    public int majorityElement(int[] arr) {
        // Sort the array
        Arrays.sort(arr);

        //freq count
        int fq = 1, ans = arr[0] , n = arr.length;

        for(int i=1; i<n; i++){
            if(arr[i] == arr[i-1]){
                fq++;
            }else{
                fq = 1;
                ans = arr[i];
            }
            // check fq is greater than n / 2 
            if(fq > n/2){
            return ans;
            }
        }
        return ans;
    }
}
