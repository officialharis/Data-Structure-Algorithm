
class Solution {
    public boolean containsDuplicate(int[] arr) {

        // Step 1: Sort the array so that duplicate values come next to each other
        Arrays.sort(arr);

        // Step 2: Traverse the array till second last element
        for (int i = 0; i < arr.length - 1; i++) {

            // Step 3: Compare current element with the next element
            // If both are equal, a duplicate exists
            if (arr[i] == arr[i + 1]) {
                return true; // Duplicate found
            }
        }

        // Step 4: If no duplicates are found after full traversal
        return false;
    }
}
