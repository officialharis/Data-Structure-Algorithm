/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;          // Value stored in the node
 *     ListNode next;    // Reference to the next node
 *     ListNode() {}
 *     ListNode(int val) { this.val = val; }
 *     ListNode(int val, ListNode next) {
 *         this.val = val;
 *         this.next = next;
 *     }
 * }
 */

class Solution {
    public ListNode mergeTwoLists(ListNode h1, ListNode h2) {

        // If first list is empty, return second list
        if (h1 == null) return h2;

        // If second list is empty, return first list
        if (h2 == null) return h1;

        // Create a dummy node to simplify list merging
        // This node is not part of the final merged list
        ListNode newNode = new ListNode(0);

        // Pointer used to build the merged list
        ListNode currNode = newNode;

        // Traverse both lists while neither is empty
        while (h1 != null && h2 != null) {

            // Compare current nodes of both lists
            if (h1.val <= h2.val) {

                // h1 has smaller or equal value
                // Attach h1 node to merged list
                currNode.next = h1;

                // Move h1 pointer to next node
                h1 = h1.next;

            } else {

                // h2 has smaller value
                // Attach h2 node to merged list
                currNode.next = h2;

                // Move h2 pointer to next node
                h2 = h2.next;
            }

            // Move currNode forward to the last added node
            currNode = currNode.next;
        }

        // At this point, one of the lists is fully traversed

        // If h1 is empty, attach remaining nodes of h2
        if (h1 == null) {
            currNode.next = h2;
        }

        // If h2 is empty, attach remaining nodes of h1
        if (h2 == null) {
            currNode.next = h1;
        }

        // System.gc() is NOT required
        // Java automatically handles memory management
        System.gc();

        // Return the head of the merged list
        // (skip the dummy node)
        return newNode.next;
    }
}


⏱ Complexity

Time: O(n + m)

Space: O(1) (no extra data structures)
