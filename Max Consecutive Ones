class Solution {
    public int findMaxConsecutiveOnes(int[] arr) {

        int tg = 1;        // target value (1)
        int count = 0;     // current consecutive count
        int maxCount = 0;  // maximum consecutive count found so far

        for (int i = 0; i < arr.length; i++) {

            // If current element is 1
            if (arr[i] == tg) {
                count++;  // increase current streak
                maxCount = Math.max(count, maxCount); // update max
            } 
            // If current element is not 1
            else {
                count = 0; // reset streak
            }
        }

        // Return the maximum consecutive ones
        return maxCount;
    }
}
