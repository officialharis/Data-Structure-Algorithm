
import java.util.HashMap;

class Solution {
    public int subarraySum(int[] nums, int k) {

        // This variable will store the final answer:
        // total number of subarrays whose sum equals k
        int count = 0;

        // This variable keeps track of the running (prefix) sum
        int sum = 0;

        // HashMap to store prefix sum frequencies
        // Key   → prefix sum value
        // Value → number of times this prefix sum has occurred
        HashMap<Integer, Integer> map = new HashMap<>();

        // Very important step:
        // We put (0 → 1) to handle cases where a subarray
        // starting from index 0 itself has sum = k
        map.put(0, 1);

        // Traverse through each element in the array
        for (int num : nums) {

            // Add current number to running prefix sum
            sum += num;

            /*
             If there exists a previous prefix sum equal to (sum - k),
             it means the subarray between that previous index and
             the current index has sum = k.

             Because:
             currentSum - previousSum = k
             ⇒ previousSum = currentSum - k
            */
            if (map.containsKey(sum - k)) {
                // Add the number of times (sum - k) occurred
                count += map.get(sum - k);
            }

            /*
             Store the current prefix sum in the map.
             If it already exists, increase its frequency.
             Otherwise, insert it with frequency 1.
            */
            map.put(sum, map.getOrDefault(sum, 0) + 1);
        }

        // Return total count of valid subarrays
        return count;
    }
}


