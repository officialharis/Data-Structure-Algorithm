class Solution {
    public double findMaxAverage(int[] arr, int k) {

        // Length of the array
        int n = arr.length;

        // This variable stores the sum of the current sliding window
        double window = 0;

        // Step 1: Calculate the sum of the first window of size k
        // This is the initial window [0 ... k-1]
        for (int i = 0; i < k; i++) {
            window += arr[i];
        }

        // Step 2: Initialize maxsum as the average of the first window
        // We store averages (not sums) to keep comparisons consistent
        double maxsum = window / k;

        // Step 3: Slide the window from index k to the end of the array
        for (int j = k; j < n; j++) {

            // Add the new element entering the window (right side)
            window += arr[j];

            // Remove the element leaving the window (left side)
            // This keeps the window size exactly k
            window -= arr[j - k];

            // Calculate the average of the current window
            double avg = window / k;

            // Update the maximum average found so far
            maxsum = Math.max(avg, maxsum);
        }

        // Step 4: Return the maximum average of any subarray of size k
        return maxsum;
    }
}

